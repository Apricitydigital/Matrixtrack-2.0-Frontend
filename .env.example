# Copy this file to .env.local to apply configuration; .env.example is a template.
# Match the existing MatrixTrack frontend's production backend.
# Database configuration stays in that backend.
MATRIXTRACK_BACKEND_URL=https://api.matrixtrack20.in
# For a separate local/test database instead, use http://127.0.0.1:4000.

# Browser API prefix. Vite proxies /backend during dev and preview.
# For production use an HTTPS backend URL, or configure a /backend reverse proxy.
VITE_API_BASE_URL=/backend
